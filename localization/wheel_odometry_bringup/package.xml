<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wheel_odometry_bringup</name>
  <version>0.0.0</version>
  <description>
    Optional odom -> base_footprint TF broadcaster sourced from the mobile
    base controller's wheel odometry topic, as an alternative to
    scan_matcher_bringup's VLP-32C-based laser odometry. Only one odometry
    source should have publish_tf enabled at a time.
  </description>
  <maintainer email="andy.flores@pucp.edu.pe">Andy Flores</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
