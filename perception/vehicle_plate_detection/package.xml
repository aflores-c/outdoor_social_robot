<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_plate_detection</name>
  <version>0.1.0</version>
  <description>
    License plate detection + registration check. Runs a plate-specific
    YOLO detector (not the COCO model used by traffic_object_detection) and
    OCR to read plate text, then publishes a std_msgs/Bool indicating
    whether a currently visible plate is on the school's registered
    allow-list. Consumed by decision_making/school_traffic_control.
  </description>
  <maintainer email="andy.flores@pucp.edu.pe">Andy Flores</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>realsense2_camera</depend>

  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <!-- ultralytics, easyocr (and torch, separately) installed via pip —
       see requirements.txt -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
